{
  "manifest_version": 3,
  "name": "CourseFlow",
  "description": "Automates learning on Coursera. Skip videos, mark readings as completed, and advance automatically.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CourseFlow"
  },
  "content_scripts": [
    {
      "matches": [
        "https://coursera.org/*",
        "https://*.coursera.org/*"
      ],
      "js": [
        "modules/video-skipper-core.js",
        "modules/utils.js",
        "modules/messaging.js",
        "modules/autopilot.js",
        "modules/assignment.js",
        "modules/ui.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.groq.com/*"
  ]
}
